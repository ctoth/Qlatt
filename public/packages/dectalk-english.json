    {
      "id": "qlatt-english",
      "version": "0.1.0"
    },
    {
      "id": "english",
      "version": "0.1.0"
    }
  ],
  "frontends": [
    {
      "id": "dectalk-english",
      "name": "DECtalk 4.63 English",
