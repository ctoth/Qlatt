{
  "name": "qlatt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:dict": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/build-cmudict.ts",
    "build:wasm": "bash build.sh",
    "build:wasm:ps": "pwsh -File build.ps1",
    "test:golden": "node --loader ts-node/esm/transpile-only --experimental-specifier-resolution=node scripts/run-golden.ts",
    "golden:declarative-summary": "node --loader ts-node/esm/transpile-only --experimental-specifier-resolution=node scripts/export-declarative-corpus-summary.ts",
    "tts-dsl": "node --loader ts-node/esm/transpile-only --experimental-specifier-resolution=node scripts/tts-dsl.ts"
  },
  "dependencies": {
    "cel-js": "^0.8.2",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "jmespath": "^0.16.0",
    "js-yaml": "^4.1.1",
    "jsonata": "^1.8.6",
    "toposort": "^2.0.2"
  },
  "devDependencies": {
    "puppeteer-core": "^23.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
