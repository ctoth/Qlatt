  "entries": [
    { "id": "bs-001", "voiceId": "betty", "text": "Yes.", "group": "one-word" },
    { "id": "bs-002", "voiceId": "betty", "text": "No.", "group": "one-word" },
    { "id": "bs-003", "voiceId": "betty", "text": "Maybe.", "group": "one-word" },
    { "id": "bs-004", "voiceId": "betty", "text": "Tomorrow.", "group": "one-word" },
    { "id": "bs-005", "voiceId": "betty", "text": "Window.", "group": "one-word" },
    { "id": "bs-006", "voiceId": "betty", "text": "Orange.", "group": "one-word" },
    { "id": "bs-007", "voiceId": "betty", "text": "Hello.", "group": "one-word" },
    { "id": "bs-008", "voiceId": "betty", "text": "Why?", "group": "one-word" },
    { "id": "bs-009", "voiceId": "betty", "text": "Really?", "group": "one-word" },
    { "id": "bs-010", "voiceId": "betty", "text": "Stop!", "group": "one-word" },
    { "id": "bs-011", "voiceId": "betty", "text": "Come in.", "group": "two-words" },
    { "id": "bs-012", "voiceId": "betty", "text": "Good night.", "group": "two-words" },
    { "id": "bs-013", "voiceId": "betty", "text": "Not yet.", "group": "two-words" },
    { "id": "bs-014", "voiceId": "betty", "text": "Over there.", "group": "two-words" },
    { "id": "bs-015", "voiceId": "betty", "text": "Thank you.", "group": "two-words" },
    { "id": "bs-016", "voiceId": "betty", "text": "Too late.", "group": "two-words" },
    { "id": "bs-017", "voiceId": "betty", "text": "Who knows?", "group": "two-words" },
    { "id": "bs-018", "voiceId": "betty", "text": "How much?", "group": "two-words" },
    { "id": "bs-019", "voiceId": "betty", "text": "Watch out!", "group": "two-words" },
    { "id": "bs-020", "voiceId": "betty", "text": "Well done!", "group": "two-words" },
    { "id": "bs-021", "voiceId": "betty", "text": "The door is open.", "group": "statement" },
    { "id": "bs-022", "voiceId": "betty", "text": "My sister plays the piano.", "group": "statement" },
    { "id": "bs-023", "voiceId": "betty", "text": "We walked along the river.", "group": "statement" },
    { "id": "bs-024", "voiceId": "betty", "text": "The bus was full this morning.", "group": "statement" },
    { "id": "bs-025", "voiceId": "betty", "text": "He left his keys on the table.", "group": "statement" },
    { "id": "bs-026", "voiceId": "betty", "text": "Rain is falling on the roof.", "group": "statement" },
    { "id": "bs-027", "voiceId": "betty", "text": "The children are asleep.", "group": "statement" },
    { "id": "bs-028", "voiceId": "betty", "text": "I like green apples.", "group": "statement" },
    { "id": "bs-029", "voiceId": "betty", "text": "She painted the fence white.", "group": "statement" },
    { "id": "bs-030", "voiceId": "betty", "text": "Our train leaves in an hour.", "group": "statement" },
    { "id": "bs-031", "voiceId": "betty", "text": "The soup needs more salt.", "group": "statement" },
    { "id": "bs-032", "voiceId": "betty", "text": "Birds sing before dawn.", "group": "statement" },
    { "id": "bs-033", "voiceId": "betty", "text": "They moved to a smaller house.", "group": "statement" },
    { "id": "bs-034", "voiceId": "betty", "text": "The meeting ended early.", "group": "statement" },
    { "id": "bs-035", "voiceId": "betty", "text": "A cold wind blew from the north.", "group": "statement" },
    { "id": "bs-036", "voiceId": "betty", "text": "You should call your mother.", "group": "statement" },
    { "id": "bs-037", "voiceId": "betty", "text": "The shop on the corner sells fresh bread every day.", "group": "statement-long" },
    { "id": "bs-038", "voiceId": "betty", "text": "I have never seen such a bright moon over the hills.", "group": "statement-long" },
    { "id": "bs-039", "voiceId": "betty", "text": "The old clock in the hall stopped working last winter.", "group": "statement-long" },
    { "id": "bs-040", "voiceId": "betty", "text": "Nobody remembered to water the plants while we were away.", "group": "statement-long" },
    { "id": "bs-041", "voiceId": "betty", "text": "My brother wants to learn how to fix his own bicycle.", "group": "statement-long" },
    { "id": "bs-042", "voiceId": "betty", "text": "The teacher asked everyone to open the book at the first page.", "group": "statement-long" },
    { "id": "bs-043", "voiceId": "betty", "text": "We found a quiet table near the back of the room.", "group": "statement-long" },
    { "id": "bs-044", "voiceId": "betty", "text": "The road to the village winds through a narrow valley.", "group": "statement-long" },
    { "id": "bs-045", "voiceId": "betty", "text": "She keeps a small notebook in the pocket of her coat.", "group": "statement-long" },
    { "id": "bs-046", "voiceId": "betty", "text": "The ferry crosses the bay twice a day in the summer.", "group": "statement-long" },
    { "id": "bs-047", "voiceId": "betty", "text": "His letter arrived three weeks after he had posted it.", "group": "statement-long" },
    { "id": "bs-048", "voiceId": "betty", "text": "The garden behind the school is full of yellow flowers.", "group": "statement-long" },
    { "id": "bs-049", "voiceId": "betty", "text": "I would rather stay at home and read by the fire.", "group": "statement-long" },
    { "id": "bs-050", "voiceId": "betty", "text": "The dog waited by the gate until the car came back.", "group": "statement-long" },
    { "id": "bs-051", "voiceId": "betty", "text": "Is the kettle on?", "group": "question-yes-no" },
    { "id": "bs-052", "voiceId": "betty", "text": "Are you coming with us?", "group": "question-yes-no" },
    { "id": "bs-053", "voiceId": "betty", "text": "Did he lock the door?", "group": "question-yes-no" },
    { "id": "bs-054", "voiceId": "betty", "text": "Can we leave now?", "group": "question-yes-no" },
    { "id": "bs-055", "voiceId": "betty", "text": "Will it rain tonight?", "group": "question-yes-no" },
    { "id": "bs-056", "voiceId": "betty", "text": "Have they eaten?", "group": "question-yes-no" },
    { "id": "bs-057", "voiceId": "betty", "text": "Does this bus go to the station?", "group": "question-yes-no" },
    { "id": "bs-058", "voiceId": "betty", "text": "Was the film any good?", "group": "question-yes-no" },
    { "id": "bs-059", "voiceId": "betty", "text": "Should I bring an umbrella?", "group": "question-yes-no" },
    { "id": "bs-060", "voiceId": "betty", "text": "Could you pass the butter?", "group": "question-yes-no" },
    { "id": "bs-061", "voiceId": "betty", "text": "Where did you put the map?", "group": "question-wh" },
    { "id": "bs-062", "voiceId": "betty", "text": "What time does the bank close?", "group": "question-wh" },
    { "id": "bs-063", "voiceId": "betty", "text": "Who left the light on?", "group": "question-wh" },
    { "id": "bs-064", "voiceId": "betty", "text": "Why is the window open?", "group": "question-wh" },
    { "id": "bs-065", "voiceId": "betty", "text": "How far is the lake?", "group": "question-wh" },
    { "id": "bs-066", "voiceId": "betty", "text": "Which road leads to the farm?", "group": "question-wh" },
    { "id": "bs-067", "voiceId": "betty", "text": "When will the others arrive?", "group": "question-wh" },
    { "id": "bs-068", "voiceId": "betty", "text": "Whose coat is this?", "group": "question-wh" },
    { "id": "bs-069", "voiceId": "betty", "text": "You saw him yesterday?", "group": "question-statement" },
    { "id": "bs-070", "voiceId": "betty", "text": "The red one?", "group": "question-statement" },
    { "id": "bs-071", "voiceId": "betty", "text": "It is cold, isn't it?", "group": "question-tag" },
    { "id": "bs-072", "voiceId": "betty", "text": "You locked the car, didn't you?", "group": "question-tag" },
    { "id": "bs-073", "voiceId": "betty", "text": "Tea or coffee?", "group": "question-choice" },
    { "id": "bs-074", "voiceId": "betty", "text": "Shall we walk, or take the bus?", "group": "question-choice" },
    { "id": "bs-075", "voiceId": "betty", "text": "What a surprise!", "group": "exclamation" },
    { "id": "bs-076", "voiceId": "betty", "text": "Look at that!", "group": "exclamation" },
    { "id": "bs-077", "voiceId": "betty", "text": "I can't believe it!", "group": "exclamation" },
    { "id": "bs-078", "voiceId": "betty", "text": "Happy birthday!", "group": "exclamation" },
    { "id": "bs-079", "voiceId": "betty", "text": "The water is freezing!", "group": "exclamation" },
    { "id": "bs-080", "voiceId": "betty", "text": "Don't touch the stove!", "group": "exclamation" },
    { "id": "bs-081", "voiceId": "betty", "text": "We won the game!", "group": "exclamation" },
    { "id": "bs-082", "voiceId": "betty", "text": "Hurry, the train is leaving!", "group": "exclamation" },
    { "id": "bs-083", "voiceId": "betty", "text": "Oh, how lovely!", "group": "exclamation" },
    { "id": "bs-084", "voiceId": "betty", "text": "That was the best meal I have ever had!", "group": "exclamation" },
    { "id": "bs-085", "voiceId": "betty", "text": "Apples, pears, and plums.", "group": "comma-list" },
    { "id": "bs-086", "voiceId": "betty", "text": "We need eggs, milk, flour, and sugar.", "group": "comma-list" },
    { "id": "bs-087", "voiceId": "betty", "text": "Monday, Tuesday, Wednesday.", "group": "comma-list" },
    { "id": "bs-088", "voiceId": "betty", "text": "She was tired, hungry, and cold.", "group": "comma-list" },
    { "id": "bs-089", "voiceId": "betty", "text": "He packed a shirt, two books, and a towel.", "group": "comma-list" },
    { "id": "bs-090", "voiceId": "betty", "text": "Slowly, quietly, he opened the door.", "group": "comma-list" },
    { "id": "bs-091", "voiceId": "betty", "text": "If it rains, we will stay inside.", "group": "comma-clause" },
    { "id": "bs-092", "voiceId": "betty", "text": "When the bell rang, everyone stood up.", "group": "comma-clause" },
    { "id": "bs-093", "voiceId": "betty", "text": "After lunch, they went for a walk.", "group": "comma-clause" },
    { "id": "bs-094", "voiceId": "betty", "text": "The car, which was very old, would not start.", "group": "comma-clause" },
    { "id": "bs-095", "voiceId": "betty", "text": "Well, I suppose you are right.", "group": "comma-clause" },
    { "id": "bs-096", "voiceId": "betty", "text": "To be honest, I forgot.", "group": "comma-clause" },
    { "id": "bs-097", "voiceId": "betty", "text": "She smiled, but said nothing.", "group": "comma-clause" },
    { "id": "bs-098", "voiceId": "betty", "text": "I knocked twice, and nobody answered.", "group": "comma-clause" },
    { "id": "bs-099", "voiceId": "betty", "text": "Anna, could you help me?", "group": "comma-clause" },
    { "id": "bs-100", "voiceId": "betty", "text": "No, thank you.", "group": "comma-clause" },
    { "id": "bs-101", "voiceId": "betty", "text": "There is one rule: be on time.", "group": "colon" },
    { "id": "bs-102", "voiceId": "betty", "text": "Bring three things: a pen, a cup, and a hat.", "group": "colon" },
    { "id": "bs-103", "voiceId": "betty", "text": "The answer is simple: we wait.", "group": "colon" },
    { "id": "bs-104", "voiceId": "betty", "text": "Remember this: never run on the stairs.", "group": "colon" },
    { "id": "bs-105", "voiceId": "betty", "text": "It was late; the streets were empty.", "group": "semicolon" },
    { "id": "bs-106", "voiceId": "betty", "text": "He spoke; she listened.", "group": "semicolon" },
    { "id": "bs-107", "voiceId": "betty", "text": "The lake was calm; not a leaf moved.", "group": "semicolon" },
    { "id": "bs-108", "voiceId": "betty", "text": "I called twice; no one was home.", "group": "semicolon" },
    { "id": "bs-109", "voiceId": "betty", "text": "She said, \"I will be back soon.\"", "group": "quoted" },
    { "id": "bs-110", "voiceId": "betty", "text": "\"Close the gate,\" he shouted.", "group": "quoted" },
    { "id": "bs-111", "voiceId": "betty", "text": "The sign said \"No entry.\"", "group": "quoted" },
    { "id": "bs-112", "voiceId": "betty", "text": "\"Where are we?\" asked the boy.", "group": "quoted" },
    { "id": "bs-113", "voiceId": "betty", "text": "He whispered, \"Follow me.\"", "group": "quoted" },
    { "id": "bs-114", "voiceId": "betty", "text": "\"It is snowing!\" cried the children.", "group": "quoted" },
    { "id": "bs-115", "voiceId": "betty", "text": "There are 12 eggs in the box.", "group": "number" },
    { "id": "bs-116", "voiceId": "betty", "text": "The bridge is 300 feet long.", "group": "number" },
    { "id": "bs-117", "voiceId": "betty", "text": "She was born in 1985.", "group": "number" },
    { "id": "bs-118", "voiceId": "betty", "text": "It costs 45 dollars.", "group": "number" },
    { "id": "bs-119", "voiceId": "betty", "text": "We waited for 20 minutes.", "group": "number" },
    { "id": "bs-120", "voiceId": "betty", "text": "The room is on floor 7.", "group": "number" },
    { "id": "bs-121", "voiceId": "betty", "text": "He ran 5 miles before breakfast.", "group": "number" },
    { "id": "bs-122", "voiceId": "betty", "text": "About 1000 people came.", "group": "number" },
    { "id": "bs-123", "voiceId": "betty", "text": "Take bus number 68.", "group": "number" },
    { "id": "bs-124", "voiceId": "betty", "text": "Half of 90 is 45.", "group": "number" },
    { "id": "bs-125", "voiceId": "betty", "text": "The first prize went to team 3.", "group": "number" },
    { "id": "bs-126", "voiceId": "betty", "text": "Two plus two is four.", "group": "number" },
    { "id": "bs-127", "voiceId": "betty", "text": "I don't know.", "group": "contraction" },
    { "id": "bs-128", "voiceId": "betty", "text": "She's already here.", "group": "contraction" },
    { "id": "bs-129", "voiceId": "betty", "text": "We'll see you later.", "group": "contraction" },
    { "id": "bs-130", "voiceId": "betty", "text": "They're not ready.", "group": "contraction" },
    { "id": "bs-131", "voiceId": "betty", "text": "It isn't far.", "group": "contraction" },
    { "id": "bs-132", "voiceId": "betty", "text": "You've done enough.", "group": "contraction" },
    { "id": "bs-133", "voiceId": "betty", "text": "He couldn't find his shoes.", "group": "contraction" },
    { "id": "bs-134", "voiceId": "betty", "text": "That's my sister's car.", "group": "contraction" },
    { "id": "bs-135", "voiceId": "betty", "text": "I'd like some water.", "group": "contraction" },
    { "id": "bs-136", "voiceId": "betty", "text": "Let's go home.", "group": "contraction" },
    { "id": "bs-137", "voiceId": "betty", "text": "Who's at the door?", "group": "contraction" },
    { "id": "bs-138", "voiceId": "betty", "text": "It wasn't me!", "group": "contraction" },
    { "id": "bs-139", "voiceId": "betty", "text": "The moon rose. The night grew still.", "group": "two-sentences" },
    { "id": "bs-140", "voiceId": "betty", "text": "Sit down. Dinner is ready.", "group": "two-sentences" },
    { "id": "bs-141", "voiceId": "betty", "text": "Is it far? I can walk.", "group": "two-sentences" },
    { "id": "bs-142", "voiceId": "betty", "text": "Wait! You forgot your bag.", "group": "two-sentences" },
    { "id": "bs-143", "voiceId": "betty", "text": "He laughed. Then he sat down, and began to write.", "group": "two-sentences" },
    { "id": "bs-144", "voiceId": "betty", "text": "The tall man in the grey coat bought a ticket and walked slowly to the far end of the platform.", "group": "very-long" },
    { "id": "bs-145", "voiceId": "betty", "text": "Every summer the family drives to the coast and stays in a small house near the harbour.", "group": "very-long" },
    { "id": "bs-146", "voiceId": "betty", "text": "Although the path was steep and the stones were wet, the climbers reached the top before noon.", "group": "very-long" },
    { "id": "bs-147", "voiceId": "betty", "text": "The baker gets up at four, lights the oven, and has the first loaves ready by six.", "group": "very-long" },
    { "id": "bs-148", "voiceId": "betty", "text": "Please remember to close the windows and turn off the lights before you leave the office tonight.", "group": "very-long" },
    { "id": "bs-149", "voiceId": "betty", "text": "An owl called from the old oak tree.", "group": "statement" },
    { "id": "bs-150", "voiceId": "betty", "text": "Usually I arrive early.", "group": "statement" }
  ]
}
