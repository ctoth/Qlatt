  "entries": [
    {"id":"ms-001", "voiceId":"paul", "text":"She bought a well-known brand.", "group":"hyphen"},
    {"id":"ms-002", "voiceId":"paul", "text":"My mother-in-law is visiting.", "group":"hyphen"},
    {"id":"ms-003", "voiceId":"paul", "text":"It was a last-minute, high-risk decision.", "group":"hyphen"},
    {"id":"ms-004", "voiceId":"paul", "text":"The six-year-old drew a self-portrait.", "group":"hyphen"},
    {"id":"ms-005", "voiceId":"paul", "text":"We need a part-time, long-term helper.", "group":"hyphen"},
    {"id":"ms-006", "voiceId":"paul", "text":"Re-enter the up-to-date password.", "group":"hyphen"},
    {"id":"ms-007", "voiceId":"paul", "text":"He is twenty-one and she is thirty-five.", "group":"hyphen"},
    {"id":"ms-008", "voiceId":"paul", "text":"Read pages 10-15 tonight.", "group":"range"},
    {"id":"ms-009", "voiceId":"paul", "text":"The shop is open 9-5 on weekdays.", "group":"range"},
    {"id":"ms-010", "voiceId":"paul", "text":"He lived there 1990-1998.", "group":"range"},
    {"id":"ms-011", "voiceId":"paul", "text":"The trip takes 2-3 hours.", "group":"range"},
    {"id":"ms-012", "voiceId":"paul", "text":"Ages 8-12 are welcome.", "group":"range"},
    {"id":"ms-013", "voiceId":"paul", "text":"He paused - then he laughed.", "group":"dash"},
    {"id":"ms-014", "voiceId":"paul", "text":"The answer -- if there is one -- is not simple.", "group":"dash"},
    {"id":"ms-015", "voiceId":"paul", "text":"Three things matter--time, money, and luck.", "group":"dash"},
    {"id":"ms-016", "voiceId":"paul", "text":"I wanted to go - really - but I could not.", "group":"dash"},
    {"id":"ms-017", "voiceId":"paul", "text":"She said yes--at last.", "group":"dash"},
    {"id":"ms-018", "voiceId":"paul", "text":"One more thing - close the gate.", "group":"dash"},
    {"id":"ms-019", "voiceId":"paul", "text":"Well... I am not sure.", "group":"ellipsis"},
    {"id":"ms-020", "voiceId":"paul", "text":"He opened the door and...", "group":"ellipsis"},
    {"id":"ms-021", "voiceId":"paul", "text":"Wait... what was that?", "group":"ellipsis"},
    {"id":"ms-022", "voiceId":"paul", "text":"I thought... never mind.", "group":"ellipsis"},
    {"id":"ms-023", "voiceId":"paul", "text":"The list goes on and on . . . and on.", "group":"ellipsis"},
    {"id":"ms-024", "voiceId":"paul", "text":"...and then it rained.", "group":"ellipsis"},
    {"id":"ms-025", "voiceId":"paul", "text":"The meeting (the second one) ran late.", "group":"parentheses-brackets"},
    {"id":"ms-026", "voiceId":"paul", "text":"He paid the fee (about ten dollars).", "group":"parentheses-brackets"},
    {"id":"ms-027", "voiceId":"paul", "text":"See the note [page four] for details.", "group":"parentheses-brackets"},
    {"id":"ms-028", "voiceId":"paul", "text":"Bring your tools (hammer, saw, nails) on Monday.", "group":"parentheses-brackets"},
    {"id":"ms-029", "voiceId":"paul", "text":"(This part is optional.)", "group":"parentheses-brackets"},
    {"id":"ms-030", "voiceId":"paul", "text":"She said [quietly] that she agreed.", "group":"parentheses-brackets"},
    {"id":"ms-031", "voiceId":"paul", "text":"The old bridge (built long ago (or so they say)) still stands.", "group":"parentheses-brackets"},
    {"id":"ms-032", "voiceId":"paul", "text":"Press the on/off switch.", "group":"slash"},
    {"id":"ms-033", "voiceId":"paul", "text":"Each student must bring his/her own lunch.", "group":"slash"},
    {"id":"ms-034", "voiceId":"paul", "text":"Answer yes/no to each question.", "group":"slash"},
    {"id":"ms-035", "voiceId":"paul", "text":"It is an and/or choice.", "group":"slash"},
    {"id":"ms-036", "voiceId":"paul", "text":"The speed limit is 55 miles/hour.", "group":"slash"},
    {"id":"ms-037", "voiceId":"paul", "text":"Call the owner / manager today.", "group":"slash"},
    {"id":"ms-038", "voiceId":"paul", "text":"That is John's coat.", "group":"possessive"},
    {"id":"ms-039", "voiceId":"paul", "text":"The dogs' bowls are empty.", "group":"possessive"},
    {"id":"ms-040", "voiceId":"paul", "text":"James's car is in the shop.", "group":"possessive"},
    {"id":"ms-041", "voiceId":"paul", "text":"The children's toys were everywhere.", "group":"possessive"},
    {"id":"ms-042", "voiceId":"paul", "text":"It is the boss's decision, not the workers'.", "group":"possessive"},
    {"id":"ms-043", "voiceId":"paul", "text":"We stayed at my parents' house.", "group":"possessive"},
    {"id":"ms-044", "voiceId":"paul", "text":"The fox's tail and the foxes' den.", "group":"possessive"},
    {"id":"ms-045", "voiceId":"paul", "text":"STOP right there.", "group":"all-caps"},
    {"id":"ms-046", "voiceId":"paul", "text":"DO NOT ENTER.", "group":"all-caps"},
    {"id":"ms-047", "voiceId":"paul", "text":"This is VERY important.", "group":"all-caps"},
    {"id":"ms-048", "voiceId":"paul", "text":"THE STORE CLOSES AT NINE TONIGHT.", "group":"all-caps"},
    {"id":"ms-049", "voiceId":"paul", "text":"Please read the WARNING label first.", "group":"all-caps"},
    {"id":"ms-050", "voiceId":"paul", "text":"I said NO.", "group":"all-caps"},
    {"id":"ms-051", "voiceId":"paul", "text":"WET PAINT, KEEP OFF THE GRASS.", "group":"all-caps"},
    {"id":"ms-052", "voiceId":"paul", "text":"the meeting is on monday.", "group":"mixed-case"},
    {"id":"ms-053", "voiceId":"paul", "text":"We Went To The Lake Last Summer.", "group":"mixed-case"},
    {"id":"ms-054", "voiceId":"paul", "text":"She uses an iPhone and a MacBook.", "group":"mixed-case"},
    {"id":"ms-055", "voiceId":"paul", "text":"tHe cAt sAt oN tHe mAt.", "group":"mixed-case"},
    {"id":"ms-056", "voiceId":"paul", "text":"McDonald and O'Brien left early.", "group":"mixed-case"},
    {"id":"ms-057", "voiceId":"paul", "text":"She finished 1st in the race.", "group":"ordinal"},
    {"id":"ms-058", "voiceId":"paul", "text":"He lives on the 3rd floor.", "group":"ordinal"},
    {"id":"ms-059", "voiceId":"paul", "text":"This is my 22nd birthday.", "group":"ordinal"},
    {"id":"ms-060", "voiceId":"paul", "text":"Turn left at 42nd Street.", "group":"ordinal"},
    {"id":"ms-061", "voiceId":"paul", "text":"It was the 100th day of school.", "group":"ordinal"},
    {"id":"ms-062", "voiceId":"paul", "text":"The 4th, 5th, and 11th rows are full.", "group":"ordinal"},
    {"id":"ms-063", "voiceId":"paul", "text":"Sales rose 15% last year.", "group":"percentage"},
    {"id":"ms-064", "voiceId":"paul", "text":"About 50% of the class passed.", "group":"percentage"},
    {"id":"ms-065", "voiceId":"paul", "text":"The rate fell to 3.5%.", "group":"percentage"},
    {"id":"ms-066", "voiceId":"paul", "text":"I am 100% sure.", "group":"percentage"},
    {"id":"ms-067", "voiceId":"paul", "text":"Only 7 percent agreed, and 93% did not.", "group":"percentage"},
    {"id":"ms-068", "voiceId":"paul", "text":"Add 1/2 cup of sugar.", "group":"fraction"},
    {"id":"ms-069", "voiceId":"paul", "text":"About 3/4 of the seats were taken.", "group":"fraction"},
    {"id":"ms-070", "voiceId":"paul", "text":"He ate 2/3 of the pie.", "group":"fraction"},
    {"id":"ms-071", "voiceId":"paul", "text":"The board is 5 1/2 feet long.", "group":"fraction"},
    {"id":"ms-072", "voiceId":"paul", "text":"Cut it into 1/8 inch strips.", "group":"fraction"},
    {"id":"ms-073", "voiceId":"paul", "text":"One half plus 1/4 is three quarters.", "group":"fraction"},
    {"id":"ms-074", "voiceId":"paul", "text":"The box weighs 5 lbs.", "group":"unit"},
    {"id":"ms-075", "voiceId":"paul", "text":"It is 10 km to the next town.", "group":"unit"},
    {"id":"ms-076", "voiceId":"paul", "text":"He is 6 ft. 2 in. tall.", "group":"unit"},
    {"id":"ms-077", "voiceId":"paul", "text":"Add 250 ml of milk.", "group":"unit"},
    {"id":"ms-078", "voiceId":"paul", "text":"The car was going 60 mph.", "group":"unit"},
    {"id":"ms-079", "voiceId":"paul", "text":"The bag holds 2 kg of rice.", "group":"unit"},
    {"id":"ms-080", "voiceId":"paul", "text":"It is 30 degrees outside.", "group":"unit"},
    {"id":"ms-081", "voiceId":"paul", "text":"Take 2 tsp. every 4 hrs.", "group":"unit"},
    {"id":"ms-082", "voiceId":"paul", "text":"The party is on May 5.", "group":"date"},
    {"id":"ms-083", "voiceId":"paul", "text":"She was born on July 4, 1976.", "group":"date"},
    {"id":"ms-084", "voiceId":"paul", "text":"The form is due 3/15/2024.", "group":"date"},
    {"id":"ms-085", "voiceId":"paul", "text":"We met on the 2nd of June.", "group":"date"},
    {"id":"ms-086", "voiceId":"paul", "text":"The letter is dated Jan. 12, 2001.", "group":"date"},
    {"id":"ms-087", "voiceId":"paul", "text":"It happened on 12 October 1999.", "group":"date"},
    {"id":"ms-088", "voiceId":"paul", "text":"The deadline is Fri., Dec. 1.", "group":"date"},
    {"id":"ms-089", "voiceId":"paul", "text":"He left in the summer of '69.", "group":"date"},
    {"id":"ms-090", "voiceId":"paul", "text":"The train leaves at 7:30.", "group":"time"},
    {"id":"ms-091", "voiceId":"paul", "text":"Lunch is at 12:00 noon.", "group":"time"},
    {"id":"ms-092", "voiceId":"paul", "text":"Call me after 5 p.m.", "group":"time"},
    {"id":"ms-093", "voiceId":"paul", "text":"The store opens at 9 AM and closes at 6 PM.", "group":"time"},
    {"id":"ms-094", "voiceId":"paul", "text":"The alarm rang at 6:05 a.m. sharp.", "group":"time"},
    {"id":"ms-095", "voiceId":"paul", "text":"The flight lands at 23:45.", "group":"time"},
    {"id":"ms-096", "voiceId":"paul", "text":"Be there by 8 o'clock.", "group":"time"},
    {"id":"ms-097", "voiceId":"paul", "text":"Write to me at john.smith@example.com.", "group":"email-web"},
    {"id":"ms-098", "voiceId":"paul", "text":"Visit www.example.com for details.", "group":"email-web"},
    {"id":"ms-099", "voiceId":"paul", "text":"The page is at http://example.org/help.", "group":"email-web"},
    {"id":"ms-100", "voiceId":"paul", "text":"Send it to info@school.edu today.", "group":"email-web"},
    {"id":"ms-101", "voiceId":"paul", "text":"Our site, example.net, is down.", "group":"email-web"},
    {"id":"ms-102", "voiceId":"paul", "text":"Her address is mary_jones99@mail.example.co.uk.", "group":"email-web"},
    {"id":"ms-103", "voiceId":"paul", "text":"Call 555-1234 after six.", "group":"phone"},
    {"id":"ms-104", "voiceId":"paul", "text":"The number is (617) 555-0142.", "group":"phone"},
    {"id":"ms-105", "voiceId":"paul", "text":"Dial 1-800-555-0199 for help.", "group":"phone"},
    {"id":"ms-106", "voiceId":"paul", "text":"My extension is 555.0173 x 42.", "group":"phone"},
    {"id":"ms-107", "voiceId":"paul", "text":"In an emergency, call 911.", "group":"phone"},
    {"id":"ms-108", "voiceId":"paul", "text":"It costs $5 a pound.", "group":"money"},
    {"id":"ms-109", "voiceId":"paul", "text":"The house sold for $2 million.", "group":"money"},
    {"id":"ms-110", "voiceId":"paul", "text":"He owes me $20.50 for lunch.", "group":"money"},
    {"id":"ms-111", "voiceId":"paul", "text":"The budget is $1.5 billion dollars.", "group":"money"},
    {"id":"ms-112", "voiceId":"paul", "text":"Tickets are $15 each or 2 for $25.", "group":"money"},
    {"id":"ms-113", "voiceId":"paul", "text":"She found 75 cents and a $1 bill.", "group":"money"},
    {"id":"ms-114", "voiceId":"paul", "text":"The fine was $1,250.00 plus costs.", "group":"money"},
    {"id":"ms-115", "voiceId":"paul", "text":"Read Chapter IV tonight.", "group":"roman"},
    {"id":"ms-116", "voiceId":"paul", "text":"King Henry VIII had six wives.", "group":"roman"},
    {"id":"ms-117", "voiceId":"paul", "text":"World War II ended in 1945.", "group":"roman"},
    {"id":"ms-118", "voiceId":"paul", "text":"See Part III, Section ii.", "group":"roman"},
    {"id":"ms-119", "voiceId":"paul", "text":"Pope John Paul II visited the city.", "group":"roman"},
    {"id":"ms-120", "voiceId":"paul", "text":"The clock showed XII.", "group":"roman"},
    {"id":"ms-121", "voiceId":"paul", "text":"J. R. Smith wrote the report.", "group":"initials"},
    {"id":"ms-122", "voiceId":"paul", "text":"The book is by C.S. Lewis.", "group":"initials"},
    {"id":"ms-123", "voiceId":"paul", "text":"Ask Mary K. Brown about it.", "group":"initials"},
    {"id":"ms-124", "voiceId":"paul", "text":"John F. Kennedy was born in 1917.", "group":"initials"},
    {"id":"ms-125", "voiceId":"paul", "text":"T. S. Eliot and W. H. Auden were poets.", "group":"initials"},
    {"id":"ms-126", "voiceId":"paul", "text":"Dr. Jones will see you now.", "group":"title"},
    {"id":"ms-127", "voiceId":"paul", "text":"Mr. and Mrs. Green live next door.", "group":"title"},
    {"id":"ms-128", "voiceId":"paul", "text":"Ask Prof. Lee or Ms. Park.", "group":"title"},
    {"id":"ms-129", "voiceId":"paul", "text":"Robert Brown, Jr., signed the letter.", "group":"title"},
    {"id":"ms-130", "voiceId":"paul", "text":"Mary White, M.D., spoke first.", "group":"title"},
    {"id":"ms-131", "voiceId":"paul", "text":"Capt. Hill and Sgt. Stone were there.", "group":"title"},
    {"id":"ms-132", "voiceId":"paul", "text":"Gov. Adams met Sen. Clark and the Rev. Mr. Hall.", "group":"title"},
    {"id":"ms-133", "voiceId":"paul", "text":"\"Did she really say 'no'?\" he asked.", "group":"quoted-nested"},
    {"id":"ms-134", "voiceId":"paul", "text":"\"Stop!\" she cried. \"Where are you going?\"", "group":"quoted-nested"},
    {"id":"ms-135", "voiceId":"paul", "text":"He called it \"the best day ever\"; I did not.", "group":"quoted-nested"},
    {"id":"ms-136", "voiceId":"paul", "text":"\"Well,\" said Tom, \"that is that.\"", "group":"quoted-nested"},
    {"id":"ms-137", "voiceId":"paul", "text":"The sign said \"Closed (back at two).\"", "group":"quoted-nested"},
    {"id":"ms-138", "voiceId":"paul", "text":"'I heard him say \"wait\",' she told us.", "group":"quoted-nested"},
    {"id":"ms-139", "voiceId":"paul", "text":"What?!", "group":"repeated-punctuation"},
    {"id":"ms-140", "voiceId":"paul", "text":"No way!!!", "group":"repeated-punctuation"},
    {"id":"ms-141", "voiceId":"paul", "text":"Are you serious??", "group":"repeated-punctuation"},
    {"id":"ms-142", "voiceId":"paul", "text":"Wait,, what did you say?", "group":"repeated-punctuation"},
    {"id":"ms-143", "voiceId":"paul", "text":"Really?! You did that!?", "group":"repeated-punctuation"},
    {"id":"ms-144", "voiceId":"paul", "text":"It is over.. I think.", "group":"repeated-punctuation"},
    {"id":"ms-145", "voiceId":"paul", "text":"See you tomorrow", "group":"no-final-punctuation"},
    {"id":"ms-146", "voiceId":"paul", "text":"The keys are on the table", "group":"no-final-punctuation"},
    {"id":"ms-147", "voiceId":"paul", "text":"Thanks, I will call you later", "group":"no-final-punctuation"},
    {"id":"ms-148", "voiceId":"paul", "text":"Is anyone there", "group":"no-final-punctuation"},
    {"id":"ms-149", "voiceId":"paul", "text":"Milk bread eggs and a dozen apples", "group":"no-final-punctuation"},
    {"id":"ms-150", "voiceId":"paul", "text":"The man who lived in the small white house at the end of the long road that ran beside the river told the children who came to visit him every Saturday morning that he had once sailed around the world on a ship that carried tea and spices from the far east to the cold ports of the north where the snow fell for six months of the year.", "group":"long-no-comma"}
  ]
