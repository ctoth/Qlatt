    { "id": "dd-single-digits-control", "text": "It is 2024-3-5 today.", "group": "dashed-date", "tags": ["control", "one-digit-groups"], "expectedFocus": ["trace"] },
    { "id": "dd-code-control", "text": "The code is 12-34-56.", "group": "dashed-date", "tags": ["control", "no-year"], "expectedFocus": ["trace"] },
