  "entries": [
    {"id":"v1--repo-003","voiceId":"paul","rate":180,"text":"Fresh frost forms on five fields.","group":"dectalk-us-sweep-v1:repo"},
    {"id":"v1--repo-015","voiceId":"paul","rate":180,"text":"Soft, safe, fuzzy, fussy, sassy, feisty, zesty, shifty.","group":"dectalk-us-sweep-v1:repo"},
    {"id":"v1--one-word-003","voiceId":"paul","rate":180,"text":"Yes.","group":"dectalk-us-sweep-v1:one-word"},
    {"id":"v1--one-word-015","voiceId":"paul","rate":180,"text":"Computer.","group":"dectalk-us-sweep-v1:one-word"},
    {"id":"v1--one-word-027","voiceId":"paul","rate":180,"text":"Father.","group":"dectalk-us-sweep-v1:one-word"},
    {"id":"v1--one-word-039","voiceId":"paul","rate":180,"text":"But.","group":"dectalk-us-sweep-v1:one-word"},
    {"id":"v1--two-word-003","voiceId":"paul","rate":180,"text":"Not now.","group":"dectalk-us-sweep-v1:two-word"},
    {"id":"v1--two-word-015","voiceId":"paul","rate":180,"text":"Our team.","group":"dectalk-us-sweep-v1:two-word"},
    {"id":"v1--two-word-027","voiceId":"paul","rate":180,"text":"For now.","group":"dectalk-us-sweep-v1:two-word"},
    {"id":"v1--two-word-039","voiceId":"paul","rate":180,"text":"Fresh bread.","group":"dectalk-us-sweep-v1:two-word"},
    {"id":"v1--function-initial-003","voiceId":"paul","rate":180,"text":"But nobody answered the door.","group":"dectalk-us-sweep-v1:function-initial"},
    {"id":"v1--function-initial-015","voiceId":"paul","rate":180,"text":"With a sigh, she sat down.","group":"dectalk-us-sweep-v1:function-initial"},
    {"id":"v1--numbers-003","voiceId":"paul","rate":180,"text":"She was born in 2004.","group":"dectalk-us-sweep-v1:numbers"},
    {"id":"v1--numbers-015","voiceId":"paul","rate":180,"text":"He finished 2nd.","group":"dectalk-us-sweep-v1:numbers"},
    {"id":"v1--numbers-027","voiceId":"paul","rate":180,"text":"The bill came to 19.99.","group":"dectalk-us-sweep-v1:numbers"},
    {"id":"v1--numbers-039","voiceId":"paul","rate":180,"text":"He owes me 100 dollars.","group":"dectalk-us-sweep-v1:numbers"},
    {"id":"v1--abbreviations-003","voiceId":"paul","rate":180,"text":"Ms. Lee teaches math.","group":"dectalk-us-sweep-v1:abbreviations"},
    {"id":"v1--abbreviations-017","voiceId":"paul","rate":180,"text":"The file is 20 MB.","group":"dectalk-us-sweep-v1:abbreviations"},
    {"id":"v1--contractions-003","voiceId":"paul","rate":180,"text":"It's raining.","group":"dectalk-us-sweep-v1:contractions"},
    {"id":"v1--contractions-015","voiceId":"paul","rate":180,"text":"What's the matter?","group":"dectalk-us-sweep-v1:contractions"},
    {"id":"v1--questions-003","voiceId":"paul","rate":180,"text":"Did he have a house?","group":"dectalk-us-sweep-v1:questions"},
    {"id":"v1--questions-015","voiceId":"paul","rate":180,"text":"How does it work?","group":"dectalk-us-sweep-v1:questions"},
    {"id":"v1--questions-027","voiceId":"paul","rate":180,"text":"Ready?","group":"dectalk-us-sweep-v1:questions"},
    {"id":"v1--questions-039","voiceId":"paul","rate":180,"text":"Have you ever been to Rome?","group":"dectalk-us-sweep-v1:questions"},
    {"id":"v1--exclamations-003","voiceId":"paul","rate":180,"text":"How strange!","group":"dectalk-us-sweep-v1:exclamations"},
    {"id":"v1--exclamations-015","voiceId":"paul","rate":180,"text":"What a beautiful morning it is!","group":"dectalk-us-sweep-v1:exclamations"},
    {"id":"v1--lists-003","voiceId":"paul","rate":180,"text":"We need bread, milk, eggs, and butter.","group":"dectalk-us-sweep-v1:lists"},
    {"id":"v1--lists-015","voiceId":"paul","rate":180,"text":"After dinner, we played cards.","group":"dectalk-us-sweep-v1:lists"},
    {"id":"v1--lists-027","voiceId":"paul","rate":180,"text":"Sooner or later, everyone leaves.","group":"dectalk-us-sweep-v1:lists"},
    {"id":"v1--colons-semicolons-003","voiceId":"paul","rate":180,"text":"Bring three things: a pen, a pad, and a map.","group":"dectalk-us-sweep-v1:colons-semicolons"},
    {"id":"v1--colons-semicolons-015","voiceId":"paul","rate":180,"text":"Some came early; others came late.","group":"dectalk-us-sweep-v1:colons-semicolons"},
    {"id":"v1--quoted-003","voiceId":"paul","rate":180,"text":"\"Where are you going?\" he asked.","group":"dectalk-us-sweep-v1:quoted"},
    {"id":"v1--quoted-015","voiceId":"paul","rate":180,"text":"She answered, \"I don't know.\"","group":"dectalk-us-sweep-v1:quoted"},
    {"id":"v1--long-003","voiceId":"paul","rate":180,"text":"She opened the letter slowly, read it twice, and then put it away without a word.","group":"dectalk-us-sweep-v1:long"},
    {"id":"v1--words-in-carrier-003","voiceId":"paul","rate":180,"text":"Say dog again.","group":"dectalk-us-sweep-v1:words-in-carrier"},
    {"id":"v1--words-in-carrier-015","voiceId":"paul","rate":180,"text":"Say strength again.","group":"dectalk-us-sweep-v1:words-in-carrier"},
    {"id":"b--everyday-003","voiceId":"paul","rate":180,"text":"My bicycle has a flat tire.","group":"dectalk-us-sweep-b-v1:everyday"},
    {"id":"b--everyday-013","voiceId":"paul","rate":180,"text":"The mail comes before noon on most days.","group":"dectalk-us-sweep-b-v1:everyday"},
    {"id":"b--everyday-023","voiceId":"paul","rate":180,"text":"The baker opens his shop at six.","group":"dectalk-us-sweep-b-v1:everyday"},
    {"id":"b--everyday-033","voiceId":"paul","rate":180,"text":"The last bus leaves at a quarter past eleven.","group":"dectalk-us-sweep-b-v1:everyday"},
    {"id":"b--long-003","voiceId":"paul","rate":180,"text":"On the first warm day of spring, the whole street came outside to wash cars, trim hedges, and talk over the fences.","group":"dectalk-us-sweep-b-v1:long"},
    {"id":"betty--bs-003","voiceId":"betty","rate":180,"text":"Maybe.","group":"dectalk-us-betty-sweep-v1:one-word"},
    {"id":"betty--bs-013","voiceId":"betty","rate":180,"text":"Not yet.","group":"dectalk-us-betty-sweep-v1:two-words"},
    {"id":"betty--bs-023","voiceId":"betty","rate":180,"text":"We walked along the river.","group":"dectalk-us-betty-sweep-v1:statement"},
    {"id":"betty--bs-032","voiceId":"betty","rate":180,"text":"Birds sing before dawn.","group":"dectalk-us-betty-sweep-v1:statement"},
    {"id":"betty--bs-039","voiceId":"betty","rate":180,"text":"The old clock in the hall stopped working last winter.","group":"dectalk-us-betty-sweep-v1:statement-long"},
    {"id":"betty--bs-048","voiceId":"betty","rate":180,"text":"The garden behind the school is full of yellow flowers.","group":"dectalk-us-betty-sweep-v1:statement-long"},
    {"id":"betty--bs-053","voiceId":"betty","rate":180,"text":"Did he lock the door?","group":"dectalk-us-betty-sweep-v1:question-yes-no"},
    {"id":"betty--bs-063","voiceId":"betty","rate":180,"text":"Who left the light on?","group":"dectalk-us-betty-sweep-v1:question-wh"},
    {"id":"betty--bs-070","voiceId":"betty","rate":180,"text":"The red one?","group":"dectalk-us-betty-sweep-v1:question-statement"},
    {"id":"betty--bs-072","voiceId":"betty","rate":180,"text":"You locked the car, didn't you?","group":"dectalk-us-betty-sweep-v1:question-tag"},
    {"id":"betty--bs-074","voiceId":"betty","rate":180,"text":"Shall we walk, or take the bus?","group":"dectalk-us-betty-sweep-v1:question-choice"},
    {"id":"betty--bs-077","voiceId":"betty","rate":180,"text":"I can't believe it!","group":"dectalk-us-betty-sweep-v1:exclamation"},
    {"id":"betty--bs-087","voiceId":"betty","rate":180,"text":"Monday, Tuesday, Wednesday.","group":"dectalk-us-betty-sweep-v1:comma-list"},
    {"id":"betty--bs-093","voiceId":"betty","rate":180,"text":"After lunch, they went for a walk.","group":"dectalk-us-betty-sweep-v1:comma-clause"},
    {"id":"betty--bs-103","voiceId":"betty","rate":180,"text":"The answer is simple: we wait.","group":"dectalk-us-betty-sweep-v1:colon"},
    {"id":"betty--bs-107","voiceId":"betty","rate":180,"text":"The lake was calm; not a leaf moved.","group":"dectalk-us-betty-sweep-v1:semicolon"},
    {"id":"betty--bs-111","voiceId":"betty","rate":180,"text":"The sign said \"No entry.\"","group":"dectalk-us-betty-sweep-v1:quoted"},
    {"id":"betty--bs-117","voiceId":"betty","rate":180,"text":"She was born in 1985.","group":"dectalk-us-betty-sweep-v1:number"},
    {"id":"betty--bs-126","voiceId":"betty","rate":180,"text":"Two plus two is four.","group":"dectalk-us-betty-sweep-v1:number"},
    {"id":"betty--bs-129","voiceId":"betty","rate":180,"text":"We'll see you later.","group":"dectalk-us-betty-sweep-v1:contraction"},
    {"id":"betty--bs-138","voiceId":"betty","rate":180,"text":"It wasn't me!","group":"dectalk-us-betty-sweep-v1:contraction"},
    {"id":"betty--bs-141","voiceId":"betty","rate":180,"text":"Is it far? I can walk.","group":"dectalk-us-betty-sweep-v1:two-sentences"},
    {"id":"betty--bs-146","voiceId":"betty","rate":180,"text":"Although the path was steep and the stones were wet, the climbers reached the top before noon.","group":"dectalk-us-betty-sweep-v1:very-long"},
    {"id":"para--ps-003","voiceId":"paul","rate":180,"text":"It had snowed all night. In the morning the road was gone, and the fence was only a line of white posts. We stayed inside and lit the fire.","group":"dectalk-us-paragraph-sweep-v1:narration"},
    {"id":"para--ps-009","voiceId":"paul","rate":180,"text":"The meeting began on time. It ended three hours later.","group":"dectalk-us-paragraph-sweep-v1:narration"},
    {"id":"para--ps-015","voiceId":"paul","rate":180,"text":"Turn left at the bank. Walk past the school. The library is the second building on the right.","group":"dectalk-us-paragraph-sweep-v1:instructions"},
    {"id":"para--ps-021","voiceId":"paul","rate":180,"text":"Plant the seeds in a row. Cover them with a little soil, and water them every evening. In a week you should see the first leaves.","group":"dectalk-us-paragraph-sweep-v1:instructions"},
    {"id":"para--ps-027","voiceId":"paul","rate":180,"text":"The old man looked up. \"You came back,\" he said. \"I said that I would.\"","group":"dectalk-us-paragraph-sweep-v1:dialogue"},
    {"id":"para--ps-033","voiceId":"paul","rate":180,"text":"\"What time is it?\" asked the boy. His mother looked at the clock. \"Time for bed,\" she said.","group":"dectalk-us-paragraph-sweep-v1:dialogue"},
    {"id":"para--ps-039","voiceId":"paul","rate":180,"text":"The garden has roses, tulips, and a few old apple trees. In spring the whole place smells sweet.","group":"dectalk-us-paragraph-sweep-v1:lists"},
    {"id":"para--ps-045","voiceId":"paul","rate":180,"text":"Red, green, and blue lights hung over the street. Under them, people danced, sang, and laughed until morning.","group":"dectalk-us-paragraph-sweep-v1:lists"},
    {"id":"para--ps-051","voiceId":"paul","rate":180,"text":"The lights are still on. Is anybody home? I knocked twice.","group":"dectalk-us-paragraph-sweep-v1:question-after-statement"},
    {"id":"para--ps-057","voiceId":"paul","rate":180,"text":"We have enough food for two days. After that, who knows? Maybe the road will be open by then.","group":"dectalk-us-paragraph-sweep-v1:question-after-statement"},
    {"id":"rate--rs-01-260","voiceId":"paul","rate":260,"text":"He had your dark suit in greasy wash water all year.","group":"dectalk-us-rate-sweep-v1:sweep-v1:repo-005"},
    {"id":"rate--rs-05-140","voiceId":"paul","rate":140,"text":"It costs $3.50.","group":"dectalk-us-rate-sweep-v1:sweep-v1:numbers-005"},
    {"id":"rate--rs-09-100","voiceId":"paul","rate":100,"text":"I can't believe it!","group":"dectalk-us-rate-sweep-v1:sweep-v1:exclamations-005"},
    {"id":"rate--rs-12-260","voiceId":"paul","rate":260,"text":"She whispered, \"Not now.\"","group":"dectalk-us-rate-sweep-v1:sweep-v1:quoted-005"},
    {"id":"rate--rs-16-140","voiceId":"paul","rate":140,"text":"He painted the fence green last summer.","group":"dectalk-us-rate-sweep-v1:sweep-b:everyday-014"},
    {"id":"rate--rs-20-100","voiceId":"paul","rate":100,"text":"Although she had read the instructions twice, the shelf still leaned to one side when she stood it against the wall.","group":"dectalk-us-rate-sweep-v1:sweep-b:long-010"},
    {"id":"rate--rs-23-260","voiceId":"betty","rate":260,"text":"I have never seen such a bright moon over the hills.","group":"dectalk-us-rate-sweep-v1:betty:bs-038"},
    {"id":"rate--rs-27-140","voiceId":"betty","rate":140,"text":"I knocked twice, and nobody answered.","group":"dectalk-us-rate-sweep-v1:betty:bs-098"},
    {"id":"rate--rs-31-100","voiceId":"paul","rate":100,"text":"It had snowed all night. In the morning the road was gone, and the fence was only a line of white posts. We stayed inside and lit the fire.","group":"dectalk-us-rate-sweep-v1:para:ps-003"},
    {"id":"rate--rs-34-260","voiceId":"paul","rate":260,"text":"Plant the seeds in a row. Cover them with a little soil, and water them every evening. In a week you should see the first leaves.","group":"dectalk-us-rate-sweep-v1:para:ps-021"},
    {"id":"rate--rs-38-140","voiceId":"paul","rate":140,"text":"Red, green, and blue lights hung over the street. Under them, people danced, sang, and laughed until morning.","group":"dectalk-us-rate-sweep-v1:para:ps-045"},
    {"id":"voice--vs-03-harry","voiceId":"harry","rate":180,"text":"Red apple.","group":"dectalk-us-voice-sweep-v1:sweep-v1:two-word-010"},
    {"id":"voice--vs-16-harry","voiceId":"harry","rate":180,"text":"She left her umbrella on the train.","group":"dectalk-us-voice-sweep-v1:sweep-b:everyday-010"},
    {"id":"voice--vs-29-harry","voiceId":"harry","rate":180,"text":"I left my bag on the chair. Now it is gone. Did you move it?","group":"dectalk-us-voice-sweep-v1:para:ps-053"},
    {"id":"voice--vs-12-frank","voiceId":"frank","rate":180,"text":"\"Wait for me,\" she called.","group":"dectalk-us-voice-sweep-v1:sweep-v1:quoted-010"},
    {"id":"voice--vs-25-frank","voiceId":"frank","rate":180,"text":"\"Are you ready?\" she asked. \"Not yet,\" he said.","group":"dectalk-us-voice-sweep-v1:para:ps-025"},
    {"id":"voice--vs-08-dennis","voiceId":"dennis","rate":180,"text":"Could you pass the salt?","group":"dectalk-us-voice-sweep-v1:sweep-v1:questions-010"},
    {"id":"voice--vs-21-dennis","voiceId":"dennis","rate":180,"text":"When the power came back on, every clock in the house was blinking and the radio started playing by itself.","group":"dectalk-us-voice-sweep-v1:sweep-b:long-005"},
    {"id":"voice--vs-04-kit","voiceId":"kit","rate":180,"text":"At the corner, turn right.","group":"dectalk-us-voice-sweep-v1:sweep-v1:function-initial-010"},
    {"id":"voice--vs-17-kit","voiceId":"kit","rate":180,"text":"Our neighbor grows roses along the wall.","group":"dectalk-us-voice-sweep-v1:sweep-b:everyday-017"},
    {"id":"voice--vs-30-kit","voiceId":"kit","rate":180,"text":"You have seen the house. You have met the neighbors. You know the price. Will you buy it? I need an answer by Friday.","group":"dectalk-us-voice-sweep-v1:para:ps-060"},
    {"id":"voice--vs-13-ursula","voiceId":"ursula","rate":180,"text":"After a long discussion, the committee decided to postpone the vote until the following week.","group":"dectalk-us-voice-sweep-v1:sweep-v1:long-010"},
    {"id":"voice--vs-26-ursula","voiceId":"ursula","rate":180,"text":"She read the note twice. \"He is not coming,\" she said at last. \"He never meant to come.\"","group":"dectalk-us-voice-sweep-v1:para:ps-032"},
    {"id":"voice--vs-09-rita","voiceId":"rita","rate":180,"text":"Happy birthday!","group":"dectalk-us-voice-sweep-v1:sweep-v1:exclamations-010"},
    {"id":"voice--vs-22-rita","voiceId":"rita","rate":180,"text":"The train left the station at six. By seven it had crossed the river. By eight the hills were behind us, and the sea was in front.","group":"dectalk-us-voice-sweep-v1:para:ps-004"},
    {"id":"voice--vs-05-wendy","voiceId":"wendy","rate":180,"text":"Add 3 and 4 to get 7.","group":"dectalk-us-voice-sweep-v1:sweep-v1:numbers-010"},
    {"id":"voice--vs-18-wendy","voiceId":"wendy","rate":180,"text":"Three sparrows sat on the wire.","group":"dectalk-us-voice-sweep-v1:sweep-b:everyday-024"}
  ]
}
