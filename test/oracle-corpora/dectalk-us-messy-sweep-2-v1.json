    {"id":"m2-138", "voiceId":"paul", "text":"what time does the train leave tomorrow", "group":"lower-case"},
    {"id":"m2-139", "voiceId":"paul", "text":"i saw john and mary at the store on main street", "group":"lower-case"},
    {"id":"m2-140", "voiceId":"paul", "text":"call me when you get home ok", "group":"lower-case"},

    {"id":"m2-141", "voiceId":"paul", "text":"She asked, \"Are you coming?\" and left.", "group":"quoted-question"},
    {"id":"m2-142", "voiceId":"paul", "text":"\"Where is it?\" he said.", "group":"quoted-question"},
    {"id":"m2-143", "voiceId":"paul", "text":"He shouted \"Stop!\" twice.", "group":"quoted-question"},
    {"id":"m2-144", "voiceId":"paul", "text":"\"Is it late?\" \"No.\" \"Then stay.\"", "group":"quoted-question"},
    {"id":"m2-145", "voiceId":"paul", "text":"I wondered, \"Why me?\" for a while.", "group":"quoted-question"},
    {"id":"m2-146", "voiceId":"paul", "text":"Did she say \"yes\" or \"no\"?", "group":"quoted-question"},
    {"id":"m2-147", "voiceId":"paul", "text":"\"Can you hear me?\" she asked. \"Yes,\" I said.", "group":"quoted-question"},
    {"id":"m2-148", "voiceId":"paul", "text":"The sign read \"Open?\" which was odd.", "group":"quoted-question"},
    {"id":"m2-149", "voiceId":"paul", "text":"\"What?\" \"Nothing.\" \"Are you sure?\"", "group":"quoted-question"},
    {"id":"m2-150", "voiceId":"paul", "text":"He asked \"Who?\" and she said \"Me.\"", "group":"quoted-question"}
  ]
