  "entries": [
    {"id":"m2-001", "voiceId":"paul", "text":"Send it to me @ home.", "group":"symbol"},
    {"id":"m2-002", "voiceId":"paul", "text":"Press # to continue.", "group":"symbol"},
    {"id":"m2-003", "voiceId":"paul", "text":"Salt & pepper are on the table.", "group":"symbol"},
    {"id":"m2-004", "voiceId":"paul", "text":"Fields marked * are required.", "group":"symbol"},
    {"id":"m2-005", "voiceId":"paul", "text":"Two + two = four.", "group":"symbol"},
    {"id":"m2-006", "voiceId":"paul", "text":"The value is < ten but > five.", "group":"symbol"},
    {"id":"m2-007", "voiceId":"paul", "text":"Type ^ and then ~ to finish.", "group":"symbol"},
    {"id":"m2-008", "voiceId":"paul", "text":"We sell books&toys here.", "group":"symbol"},
    {"id":"m2-009", "voiceId":"paul", "text":"Item #5 is missing.", "group":"symbol"},

    {"id":"m2-010", "voiceId":"paul", "text":"It is 72 degrees outside.", "group":"temperature"},
    {"id":"m2-011", "voiceId":"paul", "text":"Bake it at 350 F for an hour.", "group":"temperature"},
    {"id":"m2-012", "voiceId":"paul", "text":"Water boils at 100 C.", "group":"temperature"},
    {"id":"m2-013", "voiceId":"paul", "text":"The low was -5 degrees last night.", "group":"temperature"},
    {"id":"m2-014", "voiceId":"paul", "text":"Turn the dial 90 degrees to the left.", "group":"temperature"},
    {"id":"m2-015", "voiceId":"paul", "text":"It reached 98.6 degrees by noon.", "group":"temperature"},
    {"id":"m2-016", "voiceId":"paul", "text":"The oven is set to 425F.", "group":"temperature"},
    {"id":"m2-017", "voiceId":"paul", "text":"A fever of 101 is not high.", "group":"temperature"},

    {"id":"m2-018", "voiceId":"paul", "text":"The ticket costs 20 euros.", "group":"currency"},
    {"id":"m2-019", "voiceId":"paul", "text":"He paid 15 pounds for the book.", "group":"currency"},
    {"id":"m2-020", "voiceId":"paul", "text":"It sold for 500 yen.", "group":"currency"},
    {"id":"m2-021", "voiceId":"paul", "text":"The fee is USD 40.", "group":"currency"},
    {"id":"m2-022", "voiceId":"paul", "text":"She owes me 5 bucks.", "group":"currency"},
    {"id":"m2-023", "voiceId":"paul", "text":"A cup costs 75 cents.", "group":"currency"},
    {"id":"m2-024", "voiceId":"paul", "text":"The total came to $0.99.", "group":"currency"},
    {"id":"m2-025", "voiceId":"paul", "text":"He won $1,000,000 in the lottery.", "group":"currency"},

    {"id":"m2-026", "voiceId":"paul", "text":"The answer is -7.", "group":"signed-number"},
    {"id":"m2-027", "voiceId":"paul", "text":"Add +3 to the score.", "group":"signed-number"},
    {"id":"m2-028", "voiceId":"paul", "text":"It fell from 10 to -10.", "group":"signed-number"},
    {"id":"m2-029", "voiceId":"paul", "text":"The change was +2.5 points.", "group":"signed-number"},
    {"id":"m2-030", "voiceId":"paul", "text":"Subtract 4 - 9 and you get -5.", "group":"signed-number"},
    {"id":"m2-031", "voiceId":"paul", "text":"The balance is -$20.", "group":"signed-number"},
    {"id":"m2-032", "voiceId":"paul", "text":"Plus or minus 3 is fine.", "group":"signed-number"},
    {"id":"m2-033", "voiceId":"paul", "text":"His score was 5 +/- 1.", "group":"signed-number"},

    {"id":"m2-034", "voiceId":"paul", "text":"The odds are .5 at best.", "group":"bare-decimal"},
    {"id":"m2-035", "voiceId":"paul", "text":"It weighs .25 of a pound.", "group":"bare-decimal"},
    {"id":"m2-036", "voiceId":"paul", "text":"Use a .22 for practice.", "group":"bare-decimal"},
    {"id":"m2-037", "voiceId":"paul", "text":"The gap is 0.5 of an inch.", "group":"bare-decimal"},
    {"id":"m2-038", "voiceId":"paul", "text":"Pi is about 3.14159.", "group":"bare-decimal"},
    {"id":"m2-039", "voiceId":"paul", "text":"He ran it in 9.58 seconds.", "group":"bare-decimal"},
    {"id":"m2-040", "voiceId":"paul", "text":"The rate is 0.05 per mile.", "group":"bare-decimal"},
    {"id":"m2-041", "voiceId":"paul", "text":"Version 2.0 is out now.", "group":"bare-decimal"},

    {"id":"m2-042", "voiceId":"paul", "text":"My number is 12345678.", "group":"long-digits"},
    {"id":"m2-043", "voiceId":"paul", "text":"The code is 0042.", "group":"long-digits"},
    {"id":"m2-044", "voiceId":"paul", "text":"Dial 18005551234 now.", "group":"long-digits"},
    {"id":"m2-045", "voiceId":"paul", "text":"The serial is 9876543210123.", "group":"long-digits"},
    {"id":"m2-046", "voiceId":"paul", "text":"Enter 1234 5678 9012 3456.", "group":"long-digits"},
    {"id":"m2-047", "voiceId":"paul", "text":"The zip code is 02139.", "group":"long-digits"},
    {"id":"m2-048", "voiceId":"paul", "text":"There are 1000000 of them.", "group":"long-digits"},
    {"id":"m2-049", "voiceId":"paul", "text":"Flight 370 left at gate 12.", "group":"long-digits"},

    {"id":"m2-050", "voiceId":"paul", "text":"The part is AB123.", "group":"identifier"},
    {"id":"m2-051", "voiceId":"paul", "text":"Order X7Y9 has shipped.", "group":"identifier"},
    {"id":"m2-052", "voiceId":"paul", "text":"Use the USB2 port.", "group":"identifier"},
    {"id":"m2-053", "voiceId":"paul", "text":"Take the I95 north.", "group":"identifier"},
    {"id":"m2-054", "voiceId":"paul", "text":"Room 12B is upstairs.", "group":"identifier"},
    {"id":"m2-055", "voiceId":"paul", "text":"The model is XJ-900.", "group":"identifier"},
    {"id":"m2-056", "voiceId":"paul", "text":"My plate is 4ABC123.", "group":"identifier"},
    {"id":"m2-057", "voiceId":"paul", "text":"Seat 23A is by the window.", "group":"identifier"},
    {"id":"m2-058", "voiceId":"paul", "text":"He drives an F150.", "group":"identifier"},

    {"id":"m2-059", "voiceId":"paul", "text":"Open the file notes.txt first.", "group":"path-version"},
    {"id":"m2-060", "voiceId":"paul", "text":"It is in C:\\Users\\Paul\\notes.", "group":"path-version"},
    {"id":"m2-061", "voiceId":"paul", "text":"Look in /usr/local/bin for it.", "group":"path-version"},
    {"id":"m2-062", "voiceId":"paul", "text":"We run version 4.63 here.", "group":"path-version"},
    {"id":"m2-063", "voiceId":"paul", "text":"Update to v2.1.3 today.", "group":"path-version"},
    {"id":"m2-064", "voiceId":"paul", "text":"Save it as report_final.doc.", "group":"path-version"},
    {"id":"m2-065", "voiceId":"paul", "text":"The script is run.sh.", "group":"path-version"},
    {"id":"m2-066", "voiceId":"paul", "text":"Python 3.11 is required.", "group":"path-version"},

    {"id":"m2-067", "voiceId":"paul", "text":"She works for NASA now.", "group":"acronym"},
    {"id":"m2-068", "voiceId":"paul", "text":"The FBI and the CIA were there.", "group":"acronym"},
    {"id":"m2-069", "voiceId":"paul", "text":"He has a PhD from MIT.", "group":"acronym"},
    {"id":"m2-070", "voiceId":"paul", "text":"The CEO spoke to the UN.", "group":"acronym"},
    {"id":"m2-071", "voiceId":"paul", "text":"Send me the PDF by email.", "group":"acronym"},
    {"id":"m2-072", "voiceId":"paul", "text":"We watched it on DVD.", "group":"acronym"},
    {"id":"m2-073", "voiceId":"paul", "text":"NATO met in the USA.", "group":"acronym"},
    {"id":"m2-074", "voiceId":"paul", "text":"Her GPA is high.", "group":"acronym"},
    {"id":"m2-075", "voiceId":"paul", "text":"The ATM is out of order.", "group":"acronym"},

    {"id":"m2-076", "voiceId":"paul", "text":"J. R. Smith wrote the book.", "group":"name-form"},
    {"id":"m2-077", "voiceId":"paul", "text":"Ask Mary K. Jones about it.", "group":"name-form"},
    {"id":"m2-078", "voiceId":"paul", "text":"John Brown III was there.", "group":"name-form"},
    {"id":"m2-079", "voiceId":"paul", "text":"Dr. A. B. White, Ph.D., spoke.", "group":"name-form"},
    {"id":"m2-080", "voiceId":"paul", "text":"Mr. and Mrs. O'Brien left early.", "group":"name-form"},
    {"id":"m2-081", "voiceId":"paul", "text":"It was signed by T.S. Eliot.", "group":"name-form"},
    {"id":"m2-082", "voiceId":"paul", "text":"Henry VIII had six wives.", "group":"name-form"},
    {"id":"m2-083", "voiceId":"paul", "text":"Sam Lee Jr. and Sam Lee Sr. agree.", "group":"name-form"},

    {"id":"m2-084", "voiceId":"paul", "text":"He lives at 221B Baker Street.", "group":"address"},
    {"id":"m2-085", "voiceId":"paul", "text":"Send it to 1600 Pennsylvania Ave.", "group":"address"},
    {"id":"m2-086", "voiceId":"paul", "text":"The office is at 42 Elm St., Apt. 3.", "group":"address"},
    {"id":"m2-087", "voiceId":"paul", "text":"Turn onto N. Main St. at the light.", "group":"address"},
    {"id":"m2-088", "voiceId":"paul", "text":"Write to P.O. Box 123.", "group":"address"},
    {"id":"m2-089", "voiceId":"paul", "text":"It is on Rte. 9 near Blvd. East.", "group":"address"},
    {"id":"m2-090", "voiceId":"paul", "text":"She moved to Boston, MA 02134.", "group":"address"},
    {"id":"m2-091", "voiceId":"paul", "text":"Meet me at 5th Ave. and 42nd St.", "group":"address"},

    {"id":"m2-092", "voiceId":"paul", "text":"Bring fruit, e.g. apples.", "group":"latin"},
    {"id":"m2-093", "voiceId":"paul", "text":"He left early, i.e. before noon.", "group":"latin"},
    {"id":"m2-094", "voiceId":"paul", "text":"Bring pens, paper, etc. with you.", "group":"latin"},
    {"id":"m2-095", "voiceId":"paul", "text":"It was Smith et al. who found it.", "group":"latin"},
    {"id":"m2-096", "voiceId":"paul", "text":"See the note, cf. page ten.", "group":"latin"},
    {"id":"m2-097", "voiceId":"paul", "text":"The game is Reds vs. Blues.", "group":"latin"},
    {"id":"m2-098", "voiceId":"paul", "text":"N.B. the door sticks.", "group":"latin"},
    {"id":"m2-099", "voiceId":"paul", "text":"He paid, viz. in cash.", "group":"latin"},

    {"id":"m2-100", "voiceId":"paul", "text":"Y'all should've seen it.", "group":"contraction"},
    {"id":"m2-101", "voiceId":"paul", "text":"I'd've gone if I could.", "group":"contraction"},
    {"id":"m2-102", "voiceId":"paul", "text":"She's gonna say it ain't so.", "group":"contraction"},
    {"id":"m2-103", "voiceId":"paul", "text":"Who'd've thought it?", "group":"contraction"},
    {"id":"m2-104", "voiceId":"paul", "text":"It's five o'clock already.", "group":"contraction"},
    {"id":"m2-105", "voiceId":"paul", "text":"They're goin' fishin' today.", "group":"contraction"},
    {"id":"m2-106", "voiceId":"paul", "text":"That'll do, won't it?", "group":"contraction"},
    {"id":"m2-107", "voiceId":"paul", "text":"We mustn't and we needn't.", "group":"contraction"},

    {"id":"m2-108", "voiceId":"paul", "text":"That is Chris's bike.", "group":"possessive-s"},
    {"id":"m2-109", "voiceId":"paul", "text":"We met at the Joneses' house.", "group":"possessive-s"},
    {"id":"m2-110", "voiceId":"paul", "text":"Mr. Hughes's car is red.", "group":"possessive-s"},
    {"id":"m2-111", "voiceId":"paul", "text":"Texas' weather is hot.", "group":"possessive-s"},
    {"id":"m2-112", "voiceId":"paul", "text":"It is Ross's turn now.", "group":"possessive-s"},
    {"id":"m2-113", "voiceId":"paul", "text":"Charles' book is on the desk.", "group":"possessive-s"},
    {"id":"m2-114", "voiceId":"paul", "text":"The Williams's dog barked.", "group":"possessive-s"},
    {"id":"m2-115", "voiceId":"paul", "text":"Is this Thomas's or Lucas's?", "group":"possessive-s"},

    {"id":"m2-116", "voiceId":"paul", "text":"Oh, I see.", "group":"interjection"},
    {"id":"m2-117", "voiceId":"paul", "text":"Wow! That is huge.", "group":"interjection"},
    {"id":"m2-118", "voiceId":"paul", "text":"Hmm, let me think.", "group":"interjection"},
    {"id":"m2-119", "voiceId":"paul", "text":"Ouch! That hurt.", "group":"interjection"},
    {"id":"m2-120", "voiceId":"paul", "text":"Uh, no thanks.", "group":"interjection"},
    {"id":"m2-121", "voiceId":"paul", "text":"Oops, I dropped it.", "group":"interjection"},
    {"id":"m2-122", "voiceId":"paul", "text":"Shh! The baby is asleep.", "group":"interjection"},
    {"id":"m2-123", "voiceId":"paul", "text":"Aha, there it is.", "group":"interjection"},
    {"id":"m2-124", "voiceId":"paul", "text":"Ugh, not again.", "group":"interjection"},

    {"id":"m2-125", "voiceId":"paul", "text":"I am sooo tired.", "group":"elongated"},
    {"id":"m2-126", "voiceId":"paul", "text":"W-w-wait a minute.", "group":"elongated"},
    {"id":"m2-127", "voiceId":"paul", "text":"Nooo, do not go.", "group":"elongated"},
    {"id":"m2-128", "voiceId":"paul", "text":"It was a looong day.", "group":"elongated"},
    {"id":"m2-129", "voiceId":"paul", "text":"I, I, I do not know.", "group":"elongated"},
    {"id":"m2-130", "voiceId":"paul", "text":"B-but why?", "group":"elongated"},
    {"id":"m2-131", "voiceId":"paul", "text":"Yesss, we won.", "group":"elongated"},
    {"id":"m2-132", "voiceId":"paul", "text":"He said hellooo to everyone.", "group":"elongated"},

    {"id":"m2-133", "voiceId":"paul", "text":"hey are you coming to the party tonight", "group":"lower-case"},
