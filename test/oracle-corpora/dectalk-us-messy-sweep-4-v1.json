  "entries": [
    {"id":"m4-001", "voiceId":"paul", "text":"\"Wait,\" she said, \"I forgot my keys.\"", "group":"dialogue"},
    {"id":"m4-002", "voiceId":"paul", "text":"\"Are you coming?\" he asked.", "group":"dialogue"},
    {"id":"m4-003", "voiceId":"paul", "text":"\"No!\" cried the boy. \"Not that one!\"", "group":"dialogue"},
    {"id":"m4-004", "voiceId":"paul", "text":"She paused - then laughed - and sat down.", "group":"dialogue"},
    {"id":"m4-005", "voiceId":"paul", "text":"\"I thought - well, never mind,\" he said.", "group":"dialogue"},
    {"id":"m4-006", "voiceId":"paul", "text":"He whispered, \"Don't move,\" and waited.", "group":"dialogue"},
    {"id":"m4-007", "voiceId":"paul", "text":"\"Tomorrow,\" said Ann. \"At noon.\" \"Fine,\" said Tom.", "group":"dialogue"},
    {"id":"m4-008", "voiceId":"paul", "text":"\"If you say so--\" she began, but he was gone.", "group":"dialogue"},
    {"id":"m4-009", "voiceId":"paul", "text":"'Come in,' said the old man, 'and shut the door.'", "group":"dialogue"},
    {"id":"m4-010", "voiceId":"paul", "text":"\"Who said 'never'?\" asked the teacher.", "group":"dialogue"},

    {"id":"m4-011", "voiceId":"paul", "text":"ANNA: Where did you put the map?", "group":"script-line"},
    {"id":"m4-012", "voiceId":"paul", "text":"TOM: It is in the car. ANNA: Which car?", "group":"script-line"},
    {"id":"m4-013", "voiceId":"paul", "text":"Waiter: Are you ready to order? Guest: Not yet.", "group":"script-line"},
    {"id":"m4-014", "voiceId":"paul", "text":"MOTHER (quietly): Go to bed now.", "group":"script-line"},
    {"id":"m4-015", "voiceId":"paul", "text":"Q: How old is the house? A: About ninety years.", "group":"script-line"},
    {"id":"m4-016", "voiceId":"paul", "text":"Narrator: The rain had stopped by morning.", "group":"script-line"},
    {"id":"m4-017", "voiceId":"paul", "text":"[Door opens] Come in and sit down.", "group":"script-line"},
    {"id":"m4-018", "voiceId":"paul", "text":"JUDGE: Order! Order in the court!", "group":"script-line"},
    {"id":"m4-019", "voiceId":"paul", "text":"Host: Welcome back. Caller: Thanks for having me.", "group":"script-line"},
    {"id":"m4-020", "voiceId":"paul", "text":"Speaker 1: Can you hear me? Speaker 2: Yes, clearly.", "group":"script-line"},

