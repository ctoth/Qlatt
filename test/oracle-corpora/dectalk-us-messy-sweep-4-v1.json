    {"id":"m4-051", "voiceId":"paul", "text":"2 + 2 = 4.", "group":"arithmetic"},
    {"id":"m4-052", "voiceId":"paul", "text":"Seven minus three is 7 - 3 = 4.", "group":"arithmetic"},
    {"id":"m4-053", "voiceId":"paul", "text":"The area is 3 x 4 = 12.", "group":"arithmetic"},
    {"id":"m4-054", "voiceId":"paul", "text":"Twelve divided by four is 12 / 4 = 3.", "group":"arithmetic"},
    {"id":"m4-055", "voiceId":"paul", "text":"If x > 5 then y < 10.", "group":"arithmetic"},
    {"id":"m4-056", "voiceId":"paul", "text":"The answer is 2^10 = 1024.", "group":"arithmetic"},
    {"id":"m4-057", "voiceId":"paul", "text":"Solve 3x + 2 = 11 for x.", "group":"arithmetic"},
    {"id":"m4-058", "voiceId":"paul", "text":"The ratio is 3:2, not 2:3.", "group":"arithmetic"},
    {"id":"m4-059", "voiceId":"paul", "text":"It is about 3.14 times the radius squared.", "group":"arithmetic"},
    {"id":"m4-060", "voiceId":"paul", "text":"Keep a >= b and b != 0.", "group":"arithmetic"},

    {"id":"m4-061", "voiceId":"paul", "text":"The car did 90 km/h on the bridge.", "group":"unit-compound"},
